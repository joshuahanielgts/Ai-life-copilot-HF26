VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-publishable-key

# Optional — enables the voice coach button
VITE_VAPI_PUBLIC_KEY=your-vapi-public-key
VITE_VAPI_ASSISTANT_ID=your-vapi-assistant-id

# Required for Supabase Edge Functions (set via: npx supabase secrets set GEMINI_API_KEY=your-key --project-ref your-ref)
# GEMINI_API_KEY=your-google-gemini-api-key
